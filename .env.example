# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL / TimescaleDB
POSTGRES_USER=factoryiq
POSTGRES_PASSWORD=changeme
POSTGRES_DB=factoryiq
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432

# MQTT Broker
MQTT_HOST=mosquitto
MQTT_PORT=1883

# Simulator
SIMULATOR_PORT=8001
OPC_UA_PORT=4840

# App API
APP_PORT=8000

# MCP server auth token (set a strong random value)
MCP_BEARER_TOKEN=changeme

# Staleness threshold in seconds (tag not updated within this window → STALE)
TAG_STALENESS_THRESHOLD_SECONDS=10
