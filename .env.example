# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL / TimescaleDB
POSTGRES_USER=factoryiq
POSTGRES_PASSWORD=changeme
POSTGRES_DB=factoryiq
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432

# MQTT Broker
MQTT_HOST=mosquitto
MQTT_PORT=1883

# Simulator
SIMULATOR_PORT=8001
OPC_UA_PORT=4840

# App API
APP_PORT=8000

# MCP server auth token (set a strong random value)
MCP_BEARER_TOKEN=changeme

# Human review token — different from MCP_BEARER_TOKEN; agent never receives this
MCP_HUMAN_TOKEN=human-changeme

# Staleness threshold in seconds (tag not updated within this window → STALE)
TAG_STALENESS_THRESHOLD_SECONDS=10

# AI Agent (Milestone 3+)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AGENT_MODEL=claude-sonnet-4-6
AGENT_MAX_TOOL_CALLS=15
AGENT_TIMEOUT_SECONDS=90
# Set to true in dev/test environments to enable POST /{id}/scripted-run endpoint
ALLOW_SCRIPTED_RUNNER=false
